@using ShineBlazor.Components.Base
@typeparam TValue where TValue : struct

@inherits InputControlBase<TValue>

<div @ref="_wrapper" class="@CssClasses" style="@CssStyles">
    <div class="slider">
        <div @ref="_knob" class="knob">
            <div class="rotator">
                <div class="text"></div>
            </div>
            <div class="pointer">
                <i class="bi bi-play-fill" />
            </div>
        </div>

        <svg viewBox="0 0 160 160" class="progress-dial">
            <circle class="progress-circle-bg" cx="80" cy="80" r="75" fill="none" />
            <circle class="progress-circle-fg" cx="80" cy="80" r="75" fill="none" />
            
            <defs>
                <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color: red" />
                    <stop offset="50%" style="stop-color: orange" />
                    <stop offset="100%" style="stop-color: rgb(29, 209, 94)" />
                </linearGradient>
            </defs>
        </svg>
    </div>
    <input @ref="_input" type="range"
           min="0" max="100"
           value="@ValueAsString"
           @onchange="(args) => HandleValueChanged(args.Value)"
           hidden/>
</div>