@page "/modal"

<Page PageName="Modal">
    <Example Header="Modal Dialog" Code="@ModalCode">
        <Button Variant="Variant.Filled" Color="Base.Color.Primary" Clicked="ShowModal">
            Show Modal
        </Button>
        <Modal @bind-Show="_showModal">
            <Header>Header content.</Header>
            <Body>
                <Content>
                    @CommonStrings.LoremIpsumText
                </Content>
            </Body>
            <Footer>
                This is footer.
            </Footer>
        </Modal>
    </Example>
</Page>

@code{
    private bool _showModal;

    public string ModalCode = "<Modal @bind-Show=\"_showModal\">\n"
        + "\t<Header>Header content.</Header>\n"
        + "\t<Body>\n"
        + "\t\t<Content>\n"
        + "\t\t\t@LoremIpsumText\n"
        + "\t\t</Content>\n"
        + "\t</Body>\n"
        + "\t<Footer>\n"
        + "\t\tThis is footer.\n"
        + "\t</Footer>\n"
        + "</Modal>";

    private void ShowModal()
    {
        _showModal = true;
    }
}
