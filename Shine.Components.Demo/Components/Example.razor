@using Shine.Components.Base
@using System.Reflection

@inherits ShineComponentBase

<div class="@CssClasses">
    <h5 class="my-3">@Header</h5>
    <Content Class="card p-3 mb-3">
        @ChildContent
    </Content>

    @if (!string.IsNullOrEmpty(_exampleCode))
    {
        <div class="border border-dark-subtle rounded text-bg-light">
            <Content Class="example-header-content border-dark-subtle border-top border-bottom">
                <Text Alignment="Base.Alignment.Start">HTML</Text>
                <Clipboard Text="@_exampleCode" class="align-self-end" />
            </Content>
            <Content Class="example-content">
                <pre style="text-wrap: auto;">@_exampleCode</pre>
            </Content>
        </div>
    }
</div>
@code {
    private string _exampleCode;

    /// <summary>
    /// The header.
    /// </summary>
    [Parameter]
    public string Header { get; set; }

    /// <summary>
    /// The example.
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// The code content.
    /// </summary>
    [Parameter]
    public string Code { get; set; }

    /// <summary>
    /// The code resource file.
    /// </summary>
    [Parameter]
    public string CodeFile { get; set; }

    /// <inheritdoc/>
    protected override string ComponentName => "example";

    /// <inheritdoc/>
    protected override void OnInitialized()
    {

        base.OnInitialized();

        _exampleCode = GetExampleFile() ?? Code;
    }

    /// <summary>
    /// Gets the content of code file.
    /// </summary>
    /// <returns></returns>
    private string GetExampleFile()
    {
        try
        {
            if (!string.IsNullOrEmpty(CodeFile))
            {
                var assembly = Assembly.GetExecutingAssembly();
                using var stream = assembly.GetManifestResourceStream($"Shine.Components.Demo.Resources.Examples.{CodeFile}");
                using var reader = new StreamReader(stream);
                return reader.ReadToEnd();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load code file: {ex}");
        }
        return null;
    }
}
