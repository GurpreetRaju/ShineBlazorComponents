<Content><i class="bi bi-menu-button-wide-fill"></i> Components</Content>
<ListView TItem="Data.NavConfig" Color="Base.Color.Primary"
          Class="ps-4" Items="@Navs" TextVariant="true">
    <ItemTemplate>
        <a href="@context.Link">@context.Name</a>
    </ItemTemplate>
</ListView>

@code {
    private bool collapseNavMenu;

    private Data.NavConfig[] Navs = 
    [
        new Data.NavConfig { Name = "Carousel", Link = "carousel", },
        new Data.NavConfig { Name = "Collapse", Link = "collapsable-containers", },
        new Data.NavConfig { Name = "Data Grid", Link = "data-grid", },
        new Data.NavConfig { Name = "Drop Down", Link = "drop-down", },
        new Data.NavConfig { Name = "Form", Link = "form", },
        new Data.NavConfig { Name = "List", Link = "list-group", },
        new Data.NavConfig { Name = "Modal", Link = "modal", },
        new Data.NavConfig { Name = "Property Grid", Link = "property-grid", },
    ];

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
