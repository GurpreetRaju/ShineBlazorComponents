@using Microsoft.AspNetCore.Components.Web.Virtualization

@typeparam TItem
@inherits BackgroundComponentBase

@if (ItemTemplate == null)
{
    <ul class="@CssClasses" styles="@CssStyles" @attributes="@AdditionalAttributes">
        @RenderItems
    </ul>
}
else
{
    <div class="@CssClasses" style="@CssStyles" @attributes="@AdditionalAttributes">
        @RenderItems
    </div>
}

@code {
    /// <summary>
    /// Renders the items.
    /// </summary>
    private RenderFragment RenderItems => __builder =>
    {
        @foreach (var listItem in Items)
        {
            @RenderItem(listItem)
        }
    };

    /// <summary>
    /// Render item.
    /// </summary>
    /// <param name="listItem"></param>
    /// <returns></returns>
    private RenderFragment RenderItem(TItem listItem) => __builder =>
    {
        @if (ItemTemplate == null)
        {
            <li class="@ItemCssBuilder.Build()">
                @(ItemToText == null ? listItem : ItemToText.Invoke(listItem))
            </li>
        }
        else
        {
            <div class="@ItemCssBuilder.Build()">
                @ItemTemplate.Invoke(listItem)
            </div>
        }
    };
}