@namespace ShineBlazor.Components

@typeparam TItem
@inherits ItemsSelectionBase<TItem>

@if (Columns != null)
{
    <CascadingValue Value="this">
        <table class="@CssClasses" style="@CssStyles" @attributes="@AdditionalAttributes">
            <thead>
                <tr>
                    @Columns
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <Spinner />
                }
                else if (CurrentItems.Count > 0)
                {
                    @foreach (var item in CurrentItems)
                    {
                        @RenderRow(item)
                    }
                }
                else
                {
                    @NoItemTemplate
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="@(SelectionMode != SelectionMode.None ? ColumnDefinitions.Count + 1 : ColumnDefinitions.Count)">
                        <Pagination TotalPages="_totalPages"
                                    CurrentPage="_currentPage" CurrentPageChanged="HandleCurrentPageChanged"
                                    PageSize="_pageSize" PageSizeChanged="HandlePageSizeChanged">
                            <ItemsText>
                                <Text Typo="Typography.Span">@_totalItems Items</Text>
                            </ItemsText>
                        </Pagination>
                    </td>
                </tr>
            </tfoot>
        </table>
    </CascadingValue>
}

@code {

    /// <summary>
    /// Render the row.
    /// </summary>
    /// <param name="item"></param>
    /// <returns></returns>
    protected virtual RenderFragment RenderRow(TItem item) => __builder =>
    {
        @if (SelectionMode == SelectionMode.None && ItemClicked.HasDelegate)
        {
            <tr class="@GetRowClass(item)" @onclick="() => ItemClicked.InvokeAsync(item)">
                @RenderCells(item)
            </tr>
        }
        <tr class="@GetRowClass(item)">
            @if (SelectionMode == SelectionMode.Multiple)
            {
                <td>
                    <input type="checkbox" @onclick="() => HandleItemClicked(item)" checked="@IsItemSelected(item)" />
                </td>
            }
            else if (SelectionMode == SelectionMode.Single)
            {
                <td>
                    <input type="radio" @onclick="() => HandleItemClicked(item)" checked="@IsItemSelected(item)" />
                </td>
            }
            @RenderCells(item)
        </tr>
    };

    /// <summary>
    /// Renders the cells for item.
    /// </summary>
    /// <param name="item"></param>
    /// <returns></returns>
    protected virtual RenderFragment RenderCells(TItem item) => __builder =>
    {   
        @foreach (var column in ColumnDefinitions)
        {
            <td class="@column.GetCellClass(item)">@column.RenderCell(item)</td>
        }
    };
}
