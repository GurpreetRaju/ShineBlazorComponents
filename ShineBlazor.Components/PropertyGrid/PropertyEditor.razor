@typeparam TParent where TParent : class, new()
@inherits ShineComponentBase

@{
    var component = GetComponentToRender();
}
@if (component.DisplayPopup)
{
    <div class="property-editor form-control">
        <Button Clicked="ShowPopup" Size="Size.Sm">
            <i class="bi bi-three-dots" />
        </Button>
        <Modal Size="Size.Lg" @bind-Show="_showPopup">
            <Header>@PropertyDescriptor.Name Editor</Header>
            <Body>
                <DynamicComponent Type="component.ComponentType" Parameters="component.Parameters" />
            </Body>
            <Footer>
                <Button Color="Color.Primary" Variant="Variant.Filled" Clicked="HidePopup">Ok</Button>
            </Footer>
        </Modal>
    </div>
}
else
{
    <DynamicComponent Type="component.ComponentType" Parameters="component.Parameters" />
}