@inherits BackgroundComponentBase

<ul class="@CssClasses" style="@CssStyles" @attributes="AdditionalAttributes">
    @ChildContent
</ul>

@code {

    /// <summary>
    /// Child content.
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// Whether the navigation bar orientation is vertical.
    /// </summary>
    [Parameter]
    public bool IsVertical { get; set; }

    /// <summary>
    /// The navigation items variant.
    /// </summary>
    [Parameter]
    public NavVariant Variant { get; set; } = NavVariant.Default;

    /// <inheritdoc/>
    protected override string ComponentName => "nav";

    /// <summary>
    /// BuildStyles css for navigation list.
    /// </summary>
    protected override CssClassBuilder CssBuilder => base.CssBuilder
        .WithClass("flex-column", IsVertical)
        .WithClass(Variant);
}