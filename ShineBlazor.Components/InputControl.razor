@typeparam TValue
@inherits InputControlBase<TValue>

<input type="@InputType.ConvertToString()"
       value="@ValueAsString"
       required="@Required"
       disabled="@Disabled"
       class="@CssClasses"
       style="@CssStyles"
       readonly="@ReadOnly"
       @onchange="(args) => HandleValueChanged(args.Value)" />
