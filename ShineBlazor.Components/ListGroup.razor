@using Microsoft.AspNetCore.Components.Web.Virtualization

@typeparam TItem
@inherits ItemsSelectionBase<TItem>

<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="ItemToText" IsFixed="true">
        <ul class="@CssClasses" style="@CssStyles" @attributes="@AdditionalAttributes">
            @RenderItems
        </ul>
    </CascadingValue>
</CascadingValue>

@code {

    /// <summary>
    /// The child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The function to convert item to text.
    /// </summary>
    [Parameter]
    public Func<TItem, string>? ItemToText { get; set; }

    /// <summary>
    /// The item template.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>
    /// Whether to virtualize the items.
    /// </summary>
    [Parameter]
    public bool Virtualize { get; set; }

    /// <summary>
    /// The html element tag.
    /// </summary>
    [Parameter]
    public Element Element { get; set; } = Element.Ul;

    /// <inheritdoc/>
    protected override string ComponentName => "list-group";    

    /// <summary>
    /// BtnVariant. Default: Primary.
    /// </summary>
    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    /// <inheritdoc/>
    protected virtual string GetItemCssClasses(TItem item) => CssClassBuilder.Create("list-group-item")
        .WithClass("list-group-item-action", SelectionMode != SelectionMode.None || ItemClicked.HasDelegate)
        .WithClass($"list-group-item-{Color ?? Color.Primary}")
        .WithClass("active", IsItemSelected(item))
        .Build();

    /// <summary>
    /// Render the items.
    /// </summary>
    protected virtual RenderFragment RenderItems => __builder =>
    {
        @if (Virtualize)
        {
            <Virtualize TItem="TItem" Items="Items?.ToList()">
                <ItemContent>
                    @RenderItem(context)
                </ItemContent>
            </Virtualize>
        }
        else if (Items != null)
        {
            @foreach (var item in Items)
            {
                @RenderItem(item)
            }
        }
        @ChildContent
    };

    /// <summary>
    /// Render the item.
    /// </summary>
    /// <param name="item">The item.</param>
    /// <returns></returns>
    protected virtual RenderFragment RenderItem(TItem item) => __builder =>
    {
        <li class="@GetItemCssClasses(item)" @onclick="() => HandleItemClicked(item)">
            @if (ItemTemplate != null)
            {
                @ItemTemplate(item)
            }
            else if (ItemToText != null)
            {
                @ItemToText(item)
            }
            else
            {
                @item?.ToString()
            }
        </li>
    };
}