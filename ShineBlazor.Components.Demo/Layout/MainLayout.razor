@inherits LayoutComponentBase

<ToastProvider />

<div class="layout-wrapper">
    <AppBar BackgroundColor="Color.Primary">
        <BrandContent>
            <img src="./images/shine_white.png" alt="Shine Blazor"/>
            <Text Typo="Typography.span" Transform="Transform.Uppercase" Class="text-white">Shine Blazor</Text>
        </BrandContent>
        <ChildContent>
            <div class="flex-grow-1"/>
            <ShineBlazor.Components.Theme.ThemeSelector Theme="_theme" />
        </ChildContent>
    </AppBar>
    <DrawerContainer class="flex-grow-1">
        <LeftDrawer>
            <Drawer BackgroundColor="Color.Light" Width="16rem" Position="Enumerations.DrawerPosition.Left">
                <Navigation />
            </Drawer>
        </LeftDrawer>
        <Content>
            @Body
        </Content>
    </DrawerContainer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private readonly ShineTheme _theme = new ShineTheme();
}