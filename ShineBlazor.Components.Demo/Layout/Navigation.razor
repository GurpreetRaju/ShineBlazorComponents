
<div class="navigation">
    <div class="nav-category"><i class="bi bi-book-half"></i> Getting Started</div>
    <ListView TItem="Data.NavConfig" Color="Color.Primary"
              Class="ps-4" Items="@IntroductionNavs" TextVariant="true">
        <ItemTemplate>
            <a href="@context.Link">@context.Name</a>
        </ItemTemplate>
    </ListView>

    <div class="nav-category"><i class="bi bi-menu-button-wide-fill"></i> Components</div>
    <ListView TItem="Data.NavConfig" Color="Color.Primary"
              Class="ps-4" Items="@ComponentsNavs" TextVariant="true">
        <ItemTemplate>
            <a href="@context.Link">@context.Name</a>
        </ItemTemplate>
    </ListView>

    <div class="nav-category"><i class="bi bi-speedometer"></i> Advanced</div>
    <ListView TItem="Data.NavConfig" Color="Color.Primary"
              Class="ps-4" Items="@AdvancedNavs" TextVariant="true">
        <ItemTemplate>
            <a href="@context.Link">@context.Name</a>
        </ItemTemplate>
    </ListView>
</div>

