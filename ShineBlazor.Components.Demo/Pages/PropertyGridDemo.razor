@using ShineBlazor.Components.Base
@using ShineBlazor.Components.PropertyGrid
@using System.Globalization
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations

@page "/property-grid"

<Page PageName="Property Grid">
    <Example Header="Property Grid" CodeFile="PropertyGrid.txt">
        <Text>
            <code>PropertyGrid</code> component provides the ability to edit a complex object properties. It is very easy to use.
            Simply bind the object to the <code>Value</code> parameter on the component. There is a <code>PropertyChanged</code>
            parameter that provides the notifications when a property of the object is updated.
        </Text>
        <Text>
            <code>PropertyGrid</code> supports various attributes on the properties such as <code>DisplayNameAttribute</code>, 
            <code>DescriptionAttribute</code>, <code>RequiredAttribute</code> etc. from <code>Systen.ComponentModel</code>. For 
            providing multiple allowed values for a property, use <code>AllowedValuesAttribute</code>.
        </Text>
        <div class="row">
            <div class="col">
                <PropertyGrid @bind-Value="@_formModel" PropertyChanged="() => InvokeAsync(StateHasChanged)"></PropertyGrid>
            </div>
            <div class="col">
                <KeyValueTable TValue="string" TableTitle="Result"
                               Bordered="true" Striped="true" Class="table-sm mt-1">
                    <KeyValueTableRow Key="User Name">
                        @_formModel.Name
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Date Of Birth">
                        @(_formModel.DateOfBirth.HasValue ? _formModel.DateOfBirth.Value.ToString(CultureInfo.CurrentCulture.DateTimeFormat) : string.Empty)
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Age">
                        @_formModel.Age
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Gender Enum">
                        @_formModel.Gender
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Browsable false">
                        @_formModel.NotBrowsableValue
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="ReadOnly value">
                        @_formModel.ReadonlyValue
                    </KeyValueTableRow>
                </KeyValueTable>
            </div>
        </div>
    </Example>
    <Example Header="Property Gird - Edit Collections" CodeFile="PropertyGrid_Collections.txt">
        <Text>
            The <code>PropertyGrid</code> also has the inbuilt editors for editing collections such
            as <code>List</code> and <code>Array</code>.
        </Text>
        <div class="row">
            <div class="col">
                <PropertyGrid @bind-Value="@_shoppingCart" PropertyChanged="() => InvokeAsync(StateHasChanged)"></PropertyGrid>
            </div>
            <div class="col">
                <KeyValueTable TValue="string" TableTitle="Items"
                               Bordered="true" Striped="true" Class="table-sm">
                    <KeyValueTableRow Key="Count">
                        @(_shoppingCart.Items?.Length ?? 0)
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Total">
                        @(_shoppingCart.Items?.Sum(s => s.Price) ?? 0)
                    </KeyValueTableRow>
                </KeyValueTable>
                <KeyValueTable TValue="string" TableTitle="Coupons"
                               Bordered="true" Striped="true" Class="table-sm mt-1">
                    <KeyValueTableRow Key="Count">
                        @(_shoppingCart.Coupons?.Count ?? 0)
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Total">
                        @(_shoppingCart.Coupons?.Sum(c => c.Price) ?? 0)
                    </KeyValueTableRow>
                </KeyValueTable>
            </div>
        </div>
    </Example>
    <Example Header="Property Gird - Custom Property Editor" CodeFile="PropertyGrid_CustomEditor.txt">
        <Text>
            A custom editor can be provided for a property using <code>CustomEditor</code> attribute.
            The custom editor will show in a popup by default. If you like to show the editor inline,
            you can use <code>DisplayInline</code> property of the <code>CustomEditor</code> attribute.
        </Text>
        <div class="row">
            <div class="col">
                <PropertyGrid @bind-Value="@_editorExample" PropertyChanged="() => InvokeAsync(StateHasChanged)"></PropertyGrid>
            </div>
            <div class="col">
                <KeyValueTable TValue="string" TableTitle="Result"
                               Bordered="true" Striped="true" Class="table-sm">
                    <KeyValueTableRow Key="Name (Custom Editor)">
                        @(_editorExample.Name)
                    </KeyValueTableRow>
                    <KeyValueTableRow Key="Integer Value">
                        @(_editorExample.IntegerValue)
                    </KeyValueTableRow>
                </KeyValueTable>
            </div>
        </div>
    </Example>
</Page>

@code {
    private FormModel _formModel = new FormModel();
    private Cart _shoppingCart = new Cart();
    private EditorExample _editorExample = new EditorExample();

    /// <summary>
    /// The form model.
    /// </summary>
    private class FormModel
    {
        /// <summary>
        /// The user's name.
        /// </summary>
        public string Name { get; set; }

        /// <summary>
        /// The date of birth (DateTime).
        /// </summary>
        [Description("Date of Birth")]
        public DateTime? DateOfBirth { get; set; }

        /// <summary>
        /// The age integer value.
        /// </summary>
        public int? Age { get; set; }

        /// <summary>
        /// The Gender enum value.
        /// </summary>
        public Gender Gender { get; set; }

        /// <summary>
        /// Browsable attribute set to false.
        /// </summary>
        [System.ComponentModel.Browsable(false)]
        public bool NotBrowsableValue { get; set; }

        /// <summary>
        /// Readonly value property.
        /// </summary>
        [System.ComponentModel.ReadOnly(true)]
        public int ReadonlyValue { get; set; } = 50;
    }

    enum Gender
    {
        Male,
        Female,
        Other
    }

    public class Cart
    {
        [Description("Items is an array.")]
        public Item[] Items { get; set; }

        [Description("Coupons is a list.")]
        public List<Coupon> Coupons { get; set; }
    }

    public class Item
    {
        public string Name { get; set; }

        public int Price { get; set; }
    }

    public class Coupon
    {
        [AllowedValues("TenPercentCoupon", "FifteenPercentCoupon", "TwentyPercentCoupon")]
        public string Name { get; set; }

        public int Price { get; set; }
    }

    public class EditorExample
    {
        [CustomEditor(typeof(CustomStringEditor))]
        public string Name { get; set; }

        [DisplayName("Integer")]
        public int IntegerValue { get; set; }
    }
}
