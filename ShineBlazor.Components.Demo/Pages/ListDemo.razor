@page "/list-group"
@using ShineBlazor.Components.Base.Enumerations

<Page PageName="List Group">
    <Example Header="List Group - Simple" CodeFile="ListGroup.txt">
        <ListGroup Items="DummyDataProvider.GetFruits(5, 0)" ItemToText="t => t.Name"/>
    </Example>
    <Example Header="List Group - Custom Template" CodeFile="ListGroupCustom.txt">
        <ListGroup Items="DummyDataProvider.GetFruits(5, 0)">
            <ItemTemplate>
                <li class="list-group-item">
                    <div class="d-flex align-items-center" style="gap: 5px;">
                        <span>@context.Name</span>
                        <Badge BackgroundColor="Color.Danger" Value="@context.Quantity" />
                        <div class="flex-grow-1"></div>
                        <span><i class="bi bi-currency-dollar mr-1"></i>@context.Price</span>
                    </div>
                </li>
            </ItemTemplate>
        </ListGroup>
    </Example>
    <Example Header="List View" CodeFile="ListView.txt">
        <div class="row">
            <div class="col-4">
                <ListView Items="DummyDataProvider.GetFruits(5, 0)"
                          TextVariant="@TextVariant" Size="@Size.Value"
                          Color="SelectedColor.Value" ItemToText="f => f.Name" />
            </div>
            <div class="col-8">
                <Text>Text Variant:</Text>
                <DropDown TItem="bool" Items="[true, false]"
                          @bind-SelectedItem="TextVariant" 
                          SelectionMode="SelectionMode.Single" />
                <Text Class="mt-2">Color:</Text>
                <DropDown TItem="KeyValuePair<string, Color>" Items="Color.Values"
                          @bind-SelectedItem="SelectedColor" ItemToText="k => k.Key"
                          SelectionMode="SelectionMode.Single" />
                <Text Class="mt-2">Size:</Text>
                <DropDown TItem="KeyValuePair<string, ListViewSize>" Items="ListViewSize.Values"
                          @bind-SelectedItem="Size" ItemToText="k => k.Key"
                          SelectionMode="SelectionMode.Single" />
            </div>
        </div>
    </Example>
    <Example Header="List View - Custom Template" CodeFile="ListViewCustom.txt">
        <div class="row">
            <div class="col-4">
                <ListView Items="DummyDataProvider.GetFruits(5, 0)"
                          TextVariant="@TextVariant" Color="SelectedColor.Value" Size="@Size.Value">
                    <ItemTemplate>
                        <a href="#" class="d-flex">
                            <Text>@context.Name</Text>
                            <span class="flex-grow-1" />
                            <Text>@context.Price</Text>
                        </a>
                    </ItemTemplate>
                </ListView>
            </div>
        </div>
    </Example>
</Page>

@code {
    private KeyValuePair<string, Color> SelectedColor
    {
        get => _selectedColor;
        set 
        {
            _selectedColor = value;
            InvokeAsync(StateHasChanged);
        }
    }
    private KeyValuePair<string, Color> _selectedColor;

    private bool TextVariant
    {
        get => _textVariant;
        set
        {
            if (_textVariant != value)
            {
                _textVariant = value;
                InvokeAsync(StateHasChanged);
            }
        }
    }
    private bool _textVariant;

    private KeyValuePair<string, ListViewSize> Size
    {
        get => _size;
        set
        {
            _size = value;
            InvokeAsync(StateHasChanged);
        }
    }
    private KeyValuePair<string, ListViewSize> _size;

    /// <summary>
    /// Dummy Data Provider.
    /// </summary>
    [Inject]
    private DummyDataProvider DummyDataProvider { get; set; }
}
