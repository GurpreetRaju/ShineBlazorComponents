@page "/buttons"

<Page PageName="Buttons">
    <Example Header="Button Styles" CodeFile="ButtonStyles.txt">
        <FlexBox Row="true" AlignItems="FlexAlign.ItemsStart">
            <DropDown TItem="KeyValuePair<string, BtnVariant>" Items="BtnVariant.Values"
                      @bind-SelectedItem="_variant" ItemToText="k => k.Key"
                      Label="Variant" Variant="InputVariant.Outlined"
                      SelectionMode="SelectionMode.Single">
            </DropDown>
            <DropDown TItem="KeyValuePair<string, Color>" Items="Color.Values"
                      @bind-SelectedItem="_color" ItemToText="k => k.Key"
                      Label="Color" Variant="InputVariant.Outlined"
                      SelectionMode="SelectionMode.Single">
            </DropDown>
            <DropDown TItem="KeyValuePair<string, BtnSize>" Items="BtnSize.Values"
                      @bind-SelectedItem="_size" ItemToText="k => k.Key"
                      Label="Size" Variant="InputVariant.Outlined"
                      SelectionMode="SelectionMode.Single">
            </DropDown>
        </FlexBox>
        <div class="mt-3">
            <Button Variant="_variant.Value" Color="_color.Value" Size="_size.Value">Button</Button>
        </div>
    </Example>
    <Example Header="Button Action" CodeFile="ButtonActions.txt">
        <FlexBox Row="true" AlignItems="FlexAlign.ItemsStart">
            <Button Variant="BtnVariant.Default"
                    Color="Color.Primary"
                    Clicked="@(() => ToastService.AddToast("Button Clicked", Color.Info))"
                    Disabled="@_disable">
                Click Me!
            </Button>
            <InputControl @bind-Value="@_disable" Label="Disable button"></InputControl>
        </FlexBox>
    </Example>
</Page>

@code {
    private KeyValuePair<string, BtnVariant> _variant;
    private KeyValuePair<string, Color> _color;
    private KeyValuePair<string, BtnSize> _size;
    private bool _disable;

    /// <summary>
    /// The toast service.
    /// </summary>
    [Inject]
    private Services.ToastService ToastService { get; set; }
}