@page "/alert"

<Page PageName="Alert">
    <Example Header="Alert" CodeFile="AlertExample.txt">
        <div class="row">
            <div class="col-6">
                <Alert Color="_color">
                    <i class="bi bi-exclamation-circle-fill align-text-top"></i>
                    This is <a class="alert-link">@_color</a> alert with link.
                </Alert>
                <Alert Color="_color" Dismissible="true" @bind-Show="_show">
                    This is a dismissible @_color alert.
                </Alert>
            </div>
            <div class="col-6">
                <div class="d-flex flex-column gap-2">
                    <DropDown TItem="Color" Items="Color.Values"
                              SelectedItem="_color" SelectedItemChanged="ColorChanged"
                              SelectionMode="SelectionMode.Single">
                    </DropDown>
                    <Button Variant="Variant.Filled"
                            Clicked="ShowAlert"
                            Disabled="_show"
                            Color="Color.Primary"
                            ButtonType="ButtonType.Button">
                        Show Dismissible Alert
                    </Button>
                </div>
            </div>
        </div>
    </Example>
</Page>

@code{
    private bool _show;
    private Color _color = Color.Primary;

    private void ColorChanged(Color color)
    {
        _color = color;
        InvokeAsync(StateHasChanged);
    }

    private void ShowAlert()
    {
        _show = true;
        InvokeAsync(StateHasChanged);
    }
}