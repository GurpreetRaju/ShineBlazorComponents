@page "/alert"

<Page PageName="Alert">
    <Example Header="Alert" CodeFile="AlertExample.txt">
        <div class="row">
            <div class="col-6">
                <Alert Color="_color.Value">
                    <i class="bi bi-exclamation-circle-fill align-text-top"></i>
                    This is <a class="alert-link">@_color</a> alert with link.
                </Alert>
                <Alert Color="_color.Value" Dismissible="true" @bind-Show="_show">
                    This is a dismissible @_color alert.
                </Alert>
            </div>
            <div class="col-6">
                <div class="d-flex flex-column gap-2">
                    <DropDown TItem="KeyValuePair<string, Color>"
                              Items="Color.Values"
                              SelectedItem="_color" 
                              SelectedItemChanged="ColorChanged"
                              SelectionMode="SelectionMode.Single" 
                              ItemToText="t => t.Key">
                    </DropDown>
                    <Button Variant="BtnVariant.Default"
                            Clicked="ShowAlert"
                            Disabled="_show"
                            Color="Color.Primary"
                            ButtonType="BtnType.Button">
                        Show Dismissible Alert
                    </Button>
                </div>
            </div>
        </div>
    </Example>
</Page>

@code{
    private bool _show;
    private KeyValuePair<string, Color> _color;

    private void ColorChanged(KeyValuePair<string, Color> color)
    {
        _color = color;
        InvokeAsync(StateHasChanged);
    }

    private void ShowAlert()
    {
        _show = true;
        InvokeAsync(StateHasChanged);
    }
}