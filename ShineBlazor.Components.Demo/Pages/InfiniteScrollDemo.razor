@page "/infinite-scroll"
@using ShineBlazor.Components.Services

<Page PageName="Infinite Scroll">
    <Example Header="Infinite Scrolling" CodeFile="InfiniteScroll.txt" Class="mb-3">
        <InfiniteScroll TItem="Data.FruitData" ErrorHandler="HandleError"
                        ItemsProvider="DummyDataProvider.GetFruits">
            <ItemTemplate>
                <table class="table">
                    <tr>
                        <th scope="row" class="text-bold">ID</th>
                        <td>@context.Id</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-bold">Name</th>
                        <td>@context.Name</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-bold">Price</th>
                        <td>@context.Price</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-bold">Quantity</th>
                        <td>@context.Quantity</td>
                    </tr>
                </table>                
            </ItemTemplate>
        </InfiniteScroll>
    </Example>
</Page>

@code {

    /// <summary>
    /// Dummy data provider.
    /// </summary>
    [Inject]
    private DummyDataProvider DummyDataProvider { get; set; }

    /// <summary>
    /// Toast provider.
    /// </summary>
    [Inject]
    private ToastService ToastService { get; set; }

    /// <summary>
    /// Handles the error.
    /// </summary>
    /// <param name="ex"></param>
    private void HandleError(Exception ex)
    {
        ToastService.AddToast("Error: " + ex.Message, Base.Color.Danger);
    }
}
