@using ShineBlazor.Components

@page "/range-dial";

<Page PageName="Range Dial">
    <Example Header="Range Dial" CodeFile="RangeDial.txt">
        <Text>
            <code>RangeDial</code> uses javascript and allow input between 0 and 100 inclusive.
            To use <code>RangeDial</code> component, include following script in your <code>index.html</code>
            in <code>body</code> after the blazor framework js:<br />
            <code>@("<script src=\"_content/ShineBlazor.Components/RangeDial.razor.js\" type=\"module\"></script>")</code>
        </Text>
        <table class="table table-borderless">
            <tr>
                <td>
                    <FlexBox AlignItems="FlexAlign.Center">
                        <RangeDial TValue="int" Variant="ProgressVariant.Color" Size="150"
                                   Value="_valueColor" ValueChanged="(v) => HandleValueChanged(v, false)">
                        </RangeDial>
                    </FlexBox>
                </td>
                <td>
                    <FlexBox AlignItems="FlexAlign.Center">
                        <RangeDial TValue="int" Variant="ProgressVariant.Gradient" Size="150" ShowValue="false"
                                   Value="_valueGradient" ValueChanged="(v) => HandleValueChanged(v, true)">
                            <Alert Color="@GetColor()" Style="padding: 0.25rem 1rem;">
                                Current Value: @_valueGradient
                            </Alert>
                        </RangeDial>
                    </FlexBox>
                </td>
            </tr>
            <tr>
                <td class="align-top">
                    <Text>
                        <span class="text-bold">Example 1:</span> Range Dial with <code>Variant=ProgressVariant.Color</code>.
                        The actual value of the bound variable updates on the mouse up event:
                    </Text>
                    <FlexBox Row="true" AlignItems="FlexAlign.Center" JustifyContent="FlexContent.Center">
                        <Text Typo="Typography.span">Current Value: @_valueColor</Text>
                        <Button Size="Size.Sm" Clicked="DecreaseValue" Style="width:2rem;">-</Button>
                        <Button Size="Size.Sm" Clicked="IncreaseValue" Style="width:2rem;">+</Button>
                    </FlexBox>
                </td>
                <td class="align-top">
                    <Text>
                        <span class="text-bold">Example 2:</span> Range Dial with <code>Variant=ProgressVariant.Gradient</code> and
                        <code>ShowValue=false</code>. The custom value label is provided through <code>ChildContent</code>.
                    </Text>
                </td>
            </tr>
        </table>
    </Example>
</Page>

@code {
    private int _valueColor = 10;
    private int _valueGradient = 50;

    private void HandleValueChanged(int value, bool grad)
    {
        if (grad)
            _valueGradient = value;
        else
            _valueColor = value;

        InvokeAsync(StateHasChanged);
    }

    private void IncreaseValue()
    {
        _valueColor++;

        InvokeAsync(StateHasChanged);
    }

    private void DecreaseValue()
    {
        _valueColor--;

        InvokeAsync(StateHasChanged);
    }

    private Color GetColor()
    {
        return _valueGradient > 66 ? Color.Danger : (_valueGradient < 33 ? Color.Success : Color.Warning);
    }
}
