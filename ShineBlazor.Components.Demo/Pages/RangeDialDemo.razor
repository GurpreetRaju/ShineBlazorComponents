@using ShineBlazor.Components

@page "/range-dial";

<Page PageName="Range Dial">
    <Example Header="Range Dial" CodeFile="RangeDial.txt">
        <Text>
            <code>RangeDial</code> uses javascript and allow input between 0 and 100 inclusive.
            To use <code>RangeDial</code> component, include following script in your <code>index.html</code>
            in <code>body</code> after the blazor framework js:<br />
            <code>@("<script src=\"_content/ShineBlazor.Components/RangeDial.razor.js\" type=\"module\"></script>")</code>
        </Text>
        <table class="table table-borderless">
            <tr>
                <td>
                    <FlexBox AlignItems="FlexAlign.ItemsCenter">
                        <RangeDial TValue="int" Variant="ProgressVariant.Color" Size="150"
                                   @bind-Value="_valueColor">
                        </RangeDial>
                    </FlexBox>
                </td>
                <td>
                    <FlexBox AlignItems="FlexAlign.ItemsCenter">
                        <RangeDial TValue="int" Variant="ProgressVariant.Gradient" Size="150"
                                   ShowValue="false" @bind-Value="_valueGradient">
                            <Alert Color="@GetColor(_valueGradient)" Class="p-2">
                                @_valueGradient
                            </Alert>
                        </RangeDial>
                    </FlexBox>
                </td>
            </tr>
            <tr>
                <td class="align-top">
                    <Text>
                        <span class="text-bold">Example 1:</span> Range Dial with <code>Variant=ProgressVariant.Color</code>.
                        The actual value of the bound variable updates on the mouse up event:
                    </Text>
                </td>
                <td class="align-top">
                    <Text>
                        <span class="text-bold">Example 2:</span> Range Dial with <code>Variant=ProgressVariant.Gradient</code> and
                        <code>ShowValue=false</code>. The custom value label is provided through <code>ChildContent</code>.
                    </Text>
                </td>
            </tr>
            <tr>
                <td class="align-top">
                    <FlexBox AlignItems="FlexAlign.ItemsCenter">
                        <RangeDial TValue="int" Variant="ProgressVariant.Color"
                                   Size="150" Flat="true" @bind-Value="@_valueFlat">
                        </RangeDial>
                    </FlexBox>
                </td>
                <td class="align-top">
                    <FlexBox AlignItems="FlexAlign.ItemsCenter">
                        <RangeDial TValue="int" Variant="ProgressVariant.Gradient"
                                   Size="150" ShowValue="false" Flat="true"
                                   @bind-Value="@_valueGradientFlat">
                            <Text Class="@CssClassBuilder.Create("p-2").WithTextColor(GetColor(_valueGradientFlat)).Build()">
                                Value: @_valueGradientFlat
                            </Text>
                        </RangeDial>
                    </FlexBox>
                </td>
            </tr>
            <tr>
                <td class="align-top" colspan="2">
                    <Text Alignment="Alignment.Center">
                        <span class="text-bold">Example 3:</span> Range Dials with <code>Flat=true</code>.
                    </Text>
                </td>
            </tr>
        </table>
    </Example>
</Page>

@code {
    private int _valueColor = 10;
    private int _valueGradient = 50;
    private int _valueFlat = 30;
    private int _valueGradientFlat = 30;

    private Color GetColor(int value)
    {
        return value > 66 ? Color.Danger : (value < 33 ? Color.Success : Color.Warning);
    }
}
