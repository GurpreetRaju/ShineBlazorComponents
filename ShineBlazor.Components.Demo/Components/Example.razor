@using ShineBlazor.Components
@using ShineBlazor.Components.Base
@using System.Reflection
@using System.Web

@inherits ShineComponentBase

@inject IJSRuntime JSRuntime

<div class="@CssClasses">
    <Card Shadow="ShineBlazor.Components.Shadow.Sm">
        @if (!string.IsNullOrEmpty(Header))
        {
            <CardHeader Class="bg-body text-bold">@Header</CardHeader>
        }
        <CardBody>@ChildContent</CardBody>
        @if (!string.IsNullOrEmpty(_exampleCode))
        {
            <CardFooter>
                <div class="example-header-content border-light-subtle border-bottom">
                    <Text Alignment="Alignment.Start">HTML</Text>
                    <Clipboard Text="@_exampleCode" class="align-self-end" />
                </div>
                <Content Class="example-content">
                    <pre>
                        <code id="@CodeId" class="language-html">
                            @(_exampleCode)
                        </code>
                    </pre>
                </Content>
            </CardFooter>
        }
    </Card>
</div>
@code {
    private string _exampleCode;
    private string CodeId = $"code-{Guid.NewGuid()}";

    /// <summary>
    /// The header.
    /// </summary>
    [Parameter]
    public string Header { get; set; }

    /// <summary>
    /// The example.
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// The code resource file.
    /// </summary>
    [Parameter]
    public string CodeFile { get; set; }

    /// <summary>
    /// The flex.
    /// </summary>
    [Parameter]
    public Flex Flex { get; set; }

    /// <inheritdoc/>
    protected override string ComponentName => "example";

    /// <inheritdoc/>
    protected override CssClassBuilder CssBuilder => base.CssBuilder.WithFlex(Flex);

    /// <inheritdoc/>
    protected override void OnInitialized()
    {

        base.OnInitialized();

        if (!string.IsNullOrEmpty(CodeFile))
            _exampleCode = GetExampleFile(CodeFile);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(_exampleCode))
        {
            await JSRuntime.InvokeVoidAsync("highlightCode", CodeId);
        }
    }

    /// <summary>
    /// Gets the content of code file.
    /// </summary>
    /// <returns></returns>
    private string GetExampleFile(string file)
    {
        try
        {
            if (!string.IsNullOrEmpty(file))
            {
                var assembly = Assembly.GetExecutingAssembly();
                using var stream = assembly.GetManifestResourceStream($"ShineBlazor.Components.Demo.Resources.Examples.{file}");
                using var reader = new StreamReader(stream);
                return reader.ReadToEnd();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load code file: {ex}");
        }
        return null;
    }
}
