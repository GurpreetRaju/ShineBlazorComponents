@typeparam TCollection where TCollection : ICollection<TItem>
@typeparam TItem where TItem : class, new()

@inherits ShineComponentBase

@if (Collection != null)
{
    <div class="container collection-editor">
        <div class="row h-100 overflow-hidden">
            <div class="col-6 h-100 overflow-hidden">
                <div class="d-flex flex-column gap-1 h-100 overflow-hidden">
                    <div class="card flex-grow-1 mb-3 overflow-auto">
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Collection)
                            {
                                <li class="@CssClassBuilder.JoinClasses("list-group-item", _selectedItem == item ? "active" : null)"
                                        @onclick="() => OnItemClicked(item)">
                                    @item?.ToString()
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="d-flex gap-1">
                        <Button Variant="ButtonVariant.Primary" Clicked="AddNewItem">Add</Button>
                        <Button Variant="ButtonVariant.Danger" 
                                Outline="true"
                                Clicked="RemoveItem" 
                                Disabled="@(_selectedItem == null)">
                            Remove
                        </Button>
                    </div>
                </div>
            </div>
            <div class="col-6 h-100">
                @if (_selectedItem != null)
                {
                    <PropertyGrid @key="_selectedItem"
                                  Value="_selectedItem"
                                  PropertyChanged="() => InvokeAsync(StateHasChanged)" />
                }
            </div>
        </div>
    </div>
}