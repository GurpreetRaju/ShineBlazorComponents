@typeparam TParent
@inherits ShineComponentBase

@if (ArrayProperty != null)
{
    <div class="row">
        <div class="col">
            <div class="d-flex flex-column gap-1 h-100 overflow-hidden">
                <div class="card flex-grow-1 mb-3 overflow-auto">
                    <ul class="list-group list-group-flush">
                        @if (_existingItems != null)
                        {
                            @foreach (var item in _existingItems)
                            {
                                <li class="@CssClassBuilder.JoinClasses("list-group-item", _selectedItem == item ? "active" : null)"
                                        @onclick="() => OnItemClicked(item)">
                                    @item?.ToString()
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div class="d-flex gap-1">
                    <Button Variant="ButtonVariant.Primary" Clicked="AddNewItem">Add</Button>
                    <Button Variant="ButtonVariant.Danger" 
                            Outline="true"
                            Clicked="RemoveItem" 
                            Disabled="@(_selectedItem == null)">
                        Remove
                    </Button>
                </div>
            </div>
        </div>
        <div class="col">
            @if (_selectedItem != null)
            {
                GetDynamicParameters(out var component, out var parameters);

                <DynamicComponent Type="component"
                                  Parameters="parameters" 
                                  @key="_selectedItem" />
            }
        </div>
    </div>
}