@inherits BackgroundComponentBase

@if (Show)
{
    <div id="@Id" class="@CssClasses" style="@CssStyles" @attributes="AdditionalAttributes">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    @if (string.IsNullOrEmpty(HeaderText))
                    {
                        @Header
                    }
                    else
                    {
                        <h2 class="modal-title">@HeaderText</h2>
                    }
                    @if (CloseButton)
                    {
                        <Button @onclick="() => Toggle(false)"
                                Variant="Variant.Text"
                                Class="btn-close align-self-end"
                                aria-label="Close">
                        </Button>
                    }
                </div>
                <div class="modal-body">
                    @Body
                </div>
                @if (Footer != null)
                {
                    <div class="modal-footer">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {

    private readonly Guid Id = Guid.NewGuid();

    /// <summary>
    /// Header text.
    /// </summary>
    [Parameter]
    public string HeaderText { get; set; }

    /// <summary>
    /// Header.
    /// </summary>
    [Parameter]
    public RenderFragment Header { get; set; }

    /// <summary>
    /// Child content.
    /// </summary>
    [Parameter]
    public RenderFragment Body { get; set; }

    /// <summary>
    /// Child content.
    /// </summary>
    [Parameter]
    public RenderFragment Footer { get; set; }

    /// <summary>
    /// Modal size.
    /// </summary>
    [Parameter]
    public Size Size { get; set; }

    /// <summary>
    /// Event callback for <see cref="Show"/> changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>
    /// Show modal.
    /// </summary>
    [Parameter]
    public bool Show { get; set; }

    /// <summary>
    /// Whether to show close button in header. Default: true;
    /// </summary>
    [Parameter]
    public bool CloseButton { get; set; } = true;

    /// <inheritdoc/>
    protected override string ComponentName => "modal";

    /// <summary>
    /// Css builder.
    /// </summary>
    protected override CssClassBuilder CssBuilder => base.CssBuilder.WithClass("fade")
        .WithClass("show", Show)
        .WithClass(() => $"modal-{Size.ToString().ToLowerInvariant()}", Size != Size.Default);

    /// <summary>
    /// Toggle show state.
    /// </summary>
    /// <param name="show"></param>
    private void Toggle(bool show)
    {
        if (Show != show)
        {
            Show = show;
            ShowChanged.InvokeAsync(Show);

            InvokeAsync(StateHasChanged);
        }
    }
}